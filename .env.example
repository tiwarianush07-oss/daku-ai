# DAKU Configuration File Template
# Rename this file to .env and fill in your values.

# System Execution Mode
DAKU_MODE=cloud-lightweight
LOG_LEVEL=INFO

# Agent Backend Selection (direct | harness | uncensored)
AGENT_BACKEND=direct

# AI Model Configuration (Cloud-First)
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=your_api_key_here
MODEL_TIMEOUT_SECONDS=15.0

# DeepSeek Harness Backend (Orchestration Mode)
# DEEPSEEK_HARNESS_URL can point to direct DeepSeek API or a remote Oracle Cloud / dsh instance
DEEPSEEK_HARNESS_URL=https://api.deepseek.com/v1
HARNESS_ENDPOINT=https://api.deepseek.com/v1
HARNESS_API_KEY=your_api_key_here
HARNESS_MODEL_NAME=deepseek-chat

# Uncensored R1 Remote Backend (Remote DeepSeek R1 Distill)
UNCENSORED_BASE_URL=https://api.deepseek.com/v1
UNCENSORED_API_KEY=your_api_key_here
UNCENSORED_MODEL_NAME=deepseek-r1-distill-7b

# Speech-to-Text & Text-to-Speech
STT_PROVIDER=mic
STT_LANGUAGE=en-IN
TTS_PROVIDER=windows_native
TTS_VOICE_NAME=Microsoft David Desktop
TTS_RATE=0

# Safety & Interaction
REQUIRE_CONFIRMATION=true
WAKE_WORD_ENABLED=false

# Remote Hosting & Client Configuration
# On Remote Server (Oracle Cloud Always Free):
# In production behind Nginx reverse proxy, DAKU binds to 127.0.0.1:8443
DAKU_SERVER_HOST=127.0.0.1
DAKU_SERVER_PORT=8443

# Authentication Token (shared between client and server — change to a secure random string)
DAKU_AUTH_TOKEN=your_secret_auth_token_here

# On Windows Client Laptop (points to your remote server over secure HTTPS):
# Production Internet Traffic MUST use HTTPS (port 443 via Nginx/Caddy reverse proxy):
DAKU_SERVER_URL=https://your-domain-or-ip
# (For local offline/development testing only: DAKU_SERVER_URL=http://127.0.0.1:8443)

# Hermes Agent Gateway (local loopback on remote server)
HERMES_GATEWAY_URL=http://127.0.0.1:8080

# Sarvam Voice API (Saaras:v4 STT + Bulbul:v3 TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LANGUAGE=hi-IN