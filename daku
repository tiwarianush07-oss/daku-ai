#!/usr/bin/env bash
# ==============================================================================
# DAKU CLI Entry Point Wrapper (Linux / macOS)
# ==============================================================================
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_CMD="python3"
if [[ -f "${DIR}/venv/bin/python" ]]; then
    PYTHON_CMD="${DIR}/venv/bin/python"
fi

if [[ "$1" == "doctor" ]]; then
    shift
    "${PYTHON_CMD}" "${DIR}/doctor.py" "$@"
elif [[ "$1" == "client" ]]; then
    shift
    "${PYTHON_CMD}" "${DIR}/client.py" "$@"
elif [[ "$1" == "server" ]]; then
    shift
    "${PYTHON_CMD}" "${DIR}/server/daku_server.py" "$@"
elif [[ "$1" == "hud" ]]; then
    shift
    "${PYTHON_CMD}" "${DIR}/server/daku_server.py" --hud "$@"
elif [[ "$1" == "test" ]]; then
    shift
    "${PYTHON_CMD}" -m unittest discover -s "${DIR}/tests" -v "$@"
else
    "${PYTHON_CMD}" "${DIR}/main.py" "$@"
fi
